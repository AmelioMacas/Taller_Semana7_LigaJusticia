<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ligajusticia.FrmInforme">
  <grid id="1a2d2" binding="panelInforme" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints>
      <xy x="20" y="20" width="860" height="420"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="1a2cb" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="18" style="1"/>
          <text value="Informe de pagos - Fondo de Héroes e impuesto del gobierno"/>
        </properties>
      </component>
      <scrollpane id="1a2cc">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="250"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="1a2cd" class="javax.swing.JTable" binding="tblInforme">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="1a2ce" class="javax.swing.JLabel" binding="lblTotales">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="12" style="1"/>
          <text value="Totales:"/>
        </properties>
      </component>
      <grid id="1a2d1" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
      <hspacer id="1a2cf">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <component id="1a2d0" class="javax.swing.JButton" binding="btnCerrar">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Cerrar"/>
        </properties>
      </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
